# Supply real values outside Git or through the company secret manager.
BLAZE_RELEASE=pilot-1
BLAZE_IMAGE_REPOSITORY=blaze-pilot
BLAZE_PORT=7777
BLAZE_JWT_SECRET=
BLAZE_CORS_ORIGINS=["https://blaze.company.example"]
# Actual reverse proxy IP/CIDR seen by the container; never 0.0.0.0/0.
BLAZE_TRUSTED_PROXY_IPS=[]
