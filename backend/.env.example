# Xem docs/DEVELOPMENT.md để biết toàn bộ biến
ENABLE_LEGACY=false
ENVIRONMENT=development
DEBUG=true
# Production: ENVIRONMENT=production, DEBUG=false, COOKIE_SECURE=true,
# an independently generated JWT_SECRET, and explicit HTTPS CORS_ORIGINS.
# Back up/adopt/upgrade the DB before startup. Start with python -m scripts.serve.
# Set exact reverse-proxy IPs/CIDRs only when ingress is restricted to those proxies;
# the proxy must overwrite forwarded headers. Otherwise supply TLS key/cert to serve.
TRUSTED_PROXY_IPS=[]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=60
RATE_LIMIT_PASSWORD=30
RATE_LIMIT_CONTRIBUTIONS=120
RATE_LIMIT_FEEDBACK=60
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
BLAZE_API_TOKEN=
BLAZE_TRANSLATION_MODEL=blaze-translate-1
COOKIE_SECURE=false

# Đặt DB ngoài repo, ví dụ: sqlite:////Users/<you>/.annotator/annotator.db
DATABASE_URL=sqlite:///./annotator.db

# MinIO chạy local (xem README)
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=audios

CORS_ORIGINS=["http://localhost:7777","http://127.0.0.1:7777"]

# Ví
POINT_TO_VND=50
MIN_WITHDRAWAL_POINTS=100
