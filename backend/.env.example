# Xem docs/DEVELOPMENT.md để biết toàn bộ biến
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=60
COOKIE_SECURE=false

# Đặt DB ngoài repo, ví dụ: sqlite:////Users/<you>/.annotator/annotator.db
DATABASE_URL=sqlite:///./annotator.db

# MinIO chạy local (xem README)
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=audios

CORS_ORIGINS=["http://localhost:7777","http://127.0.0.1:7777"]

# Ví
POINT_TO_VND=50
MIN_WITHDRAWAL_POINTS=100
